.env
.env.*
!.env.example
*.key
*_key.json

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Artefactos generados al correr los notebooks localmente
*.pdf
!ejemplos/*.pdf

